generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  REOPENED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  INCIDENT_CREATED
  INCIDENT_ASSIGNED
  INCIDENT_RESOLVED
  MENTION
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  avatarUrl      String?
  // Bumped on password reset to revoke previously issued JWT sessions.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships  Membership[]
  assignments  IncidentAssignment[]
  comments     IncidentComment[]
  notifications Notification[]
  auditEvents  AuditEvent[]
  resetTokens  PasswordResetToken[]

  @@index([email])
}

// Single-use, short-lived password-reset tokens. Only the SHA-256 hash is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  services    Service[]
  incidents   Incident[]
  runbooks    Runbook[]
  apiKeys     IngestApiKey[]
  auditEvents AuditEvent[]

  @@index([slug])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Service {
  id               String        @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  healthCheckUrl   String?
  checkIntervalSec Int           @default(60)
  timeoutMs        Int           @default(8000)
  failureThreshold Int           @default(3)
  status           ServiceStatus @default(UNKNOWN)
  lastLatencyMs    Int?
  lastCheckedAt    DateTime?
  consecutiveFails Int           @default(0)
  archived         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checks       HealthCheck[]
  logs         LogEvent[]
  incidents    Incident[]
  runbooks     Runbook[]

  @@index([organizationId, archived])
  @@index([organizationId, status])
}

model HealthCheck {
  id             String   @id @default(cuid())
  serviceId      String
  ok             Boolean
  latencyMs      Int?
  statusCode     Int?
  error          String?
  checkedAt      DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, checkedAt])
}

model IngestApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String    @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model LogEvent {
  id            String   @id @default(cuid())
  organizationId String
  serviceId     String?
  severity      Severity @default(LOW)
  environment   String   @default("production")
  message       String
  stackTrace    String?
  traceId       String?
  metadata      Json?
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, timestamp])
  @@index([serviceId, timestamp])
  @@index([organizationId, severity])
  @@index([traceId])
}

model Incident {
  id             String         @id @default(cuid())
  organizationId String
  serviceId      String?
  title          String
  description    String?
  severity       Severity       @default(MEDIUM)
  status         IncidentStatus @default(OPEN)
  dedupKey       String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignments  IncidentAssignment[]
  comments     IncidentComment[]
  activities   IncidentActivity[]
  investigations AiInvestigation[]

  @@unique([organizationId, dedupKey])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([serviceId])
}

model IncidentAssignment {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
}

model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model IncidentActivity {
  id         String   @id @default(cuid())
  incidentId String
  actorId    String?
  action     String
  detail     String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model Runbook {
  id             String   @id @default(cuid())
  organizationId String
  serviceId      String?
  title          String
  category       String   @default("general")
  contentMd      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, category])
  @@index([serviceId])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  type           NotificationType
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AiInvestigation {
  id             String   @id @default(cuid())
  incidentId     String
  organizationId String
  model          String
  summary        String
  probableCause  String
  confidence     Float
  confidenceNote String?
  evidence       Json
  hypotheses     Json
  nextSteps      Json
  remediation    Json
  warnings       Json
  redacted       Boolean  @default(true)
  createdAt      DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
