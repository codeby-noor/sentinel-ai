# ---- Core runtime ----
NODE_ENV=development
# ---- API ----
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
# PostgreSQL (Docker Compose default). Override for managed Postgres.
DATABASE_URL=postgresql://sentinel:sentinel_dev_password@localhost:5432/sentinel?schema=public
# Redis (BullMQ). If empty/unreachable, API falls back to in-process scheduler.
REDIS_URL=redis://localhost:6379
# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
# ---- AI (optional, server-only) ----
# Leave empty to run the app without AI. UI shows an honest "not configured" state.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
# Comma-separated keys/patterns to redact before sending telemetry to the AI provider.
SECRET_REDACT_PATTERNS=api_key,apikey,secret,token,password,authorization,bearer
# ---- Health checks ----
HEALTHCHECK_INTERVAL_MS=60000
HEALTHCHECK_TIMEOUT_MS=8000
HEALTHCHECK_FAILURE_THRESHOLD=3
# ---- Frontend (public, NEXT_PUBLIC_ only) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# ---- Email (optional SMTP for password-reset delivery) ----
# When SMTP_HOST is empty, no reset email is sent. Development builds then expose
# a dev-only reset link in the forgot-password API response (never in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
